# Copy these into the Coolify app's environment variables. Never commit real values.

# Required — clients must send "Authorization: Bearer <this>"
MCP_AUTH_TOKEN=generate-a-long-random-string

# Claude Code — set ONE of these
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=          # from `claude setup-token` (uses a Claude subscription)
# CLAUDE_MODEL=                     # optional, e.g. a specific model id

# GitHub — fine-grained token for udayaugustin/erp_hub_mock only, Contents: read & write
GITHUB_TOKEN=
GIT_AUTHOR_NAME=mock-builder
GIT_AUTHOR_EMAIL=mock-builder@users.noreply.github.com

# jarvis-fleet (deployment)
JARVIS_FLEET_TOKEN=
# JARVIS_MCP_URL=https://mcp.13.140.175.74.sslip.io/mcp
# DEPLOY_APP_NAME=ERP Mock
# DEPLOY_HOST=jp-contabo-vps
# DEPLOY_FQDN=https://mock.infyits.com

# Optional tuning
# PHASE_TIMEOUT_SECONDS=5400
# CLAUDE_MAX_TURNS=300
# CLAUDE_MAX_BUDGET_USD=15           # cap per Claude Code run (API key only)
